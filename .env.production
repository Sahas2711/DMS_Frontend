# Production build: FastAPI serves the built SPA and the API from the SAME
# origin, so VITE_API_BASE_URL must be empty (API_V1 -> "/api/v1" relative).
# This file is loaded in "vite build" (production mode) with precedence over
# .env, so a committed .env pointing at localhost can never leak into the
# production bundle.
VITE_API_BASE_URL=